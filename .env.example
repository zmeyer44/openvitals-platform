DATABASE_URL=postgres://openvitals:openvitals@localhost:5432/openvitals
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
PG_POOL_MAX=10
OPENVITALS_OBJECT_STORAGE_ROOT=.data/blobs
OPENVITALS_WORKER_ID=local-worker
OPENVITALS_WEBHOOK_REPLAY_TTL_SECONDS=300
# 32 random bytes, base64 encoded. Example: openssl rand -base64 32
OPENVITALS_ENCRYPTION_KEY_BASE64=
# Vercel AI Gateway key. When unset, PDFs fall back to the manual-review placeholder parser.
AI_GATEWAY_API_KEY=
# Optional override for the PDF extraction model. Default: anthropic/claude-sonnet-4.6
OPENVITALS_PDF_LLM_MODEL=
