{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@openvitals/database": ["packages/database/src/index.ts"],
      "@openvitals/database/*": ["packages/database/src/*"],
      "@openvitals/domain": ["packages/domain/src/index.ts"],
      "@openvitals/domain/*": ["packages/domain/src/*"],
      "@openvitals/events": ["packages/events/src/index.ts"],
      "@openvitals/events/*": ["packages/events/src/*"],
      "@openvitals/ingestion": ["packages/ingestion/src/index.ts"],
      "@openvitals/ingestion/*": ["packages/ingestion/src/*"]
    }
  }
}
